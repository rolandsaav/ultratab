{
  "manifest_version": 3,
  "name": "Ultra Tab",
  "version": "1.0.0",
  "description": "Command palette for tabs.",
  "browser_specific_settings": {
    "gecko": {
      "id": "rolandsaavedra22@gmail.com"
    }
  },
  "permissions": [
    "tabs",
    "storage",
    "bookmarks",
    "history",
    "downloads",
    "downloads.open"
  ],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "toggle-palette": {
      "description": "Toggle the Ultra Tab palette"
    }
  },
  "action": {
    "default_title": "Toggle Ultra Tab"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
